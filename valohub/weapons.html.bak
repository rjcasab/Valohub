                                <span class="stat-label">Cargador</span>
                                <span class="stat-value">25</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Cadencia</span>
                                <span class="stat-value">9.75 b/s</span>
                            </div>
                            <div class="stat-item">
